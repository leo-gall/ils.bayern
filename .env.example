# Claude API key, used server-side only for caller/radio roleplay (server/api/llm/*)
# Maps to runtimeConfig.anthropicApiKey via Nuxt's NUXT_ env convention.
NUXT_ANTHROPIC_API_KEY=

# OpenRouteService API key (free tier: https://openrouteservice.org/dev/#/signup)
# used server-side only for real driving-time routing (server/api/routing.get.ts)
# Maps to runtimeConfig.orsApiKey via Nuxt's NUXT_ env convention.
NUXT_ORS_API_KEY=
